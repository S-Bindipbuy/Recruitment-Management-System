# Copy this file to .env and fill in the required values.
# Values already present in the real environment take precedence over .env.

# --- Required -------------------------------------------------------------
# The server refuses to start if any of these is missing or empty.

# Turso/libSQL database URL. Supported forms:
#
#   file:./storage/db                  local libSQL/SQLite file (default)
#   libsql://<db>-<org>.turso.io       remote Turso database
#   http://127.0.0.1:8080              local `turso dev` server
#
# A bare path (e.g. ./storage/db) is treated as a local file too.
TURSO_DATABASE_URL=file:./storage/db

# Secret used to sign JWT tokens. Use a long, random value in production,
# e.g. `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret

# Root directory of the frontend assets (static/, templates/, components/).
FRONTEND_PATH=./frontend

# --- Optional -------------------------------------------------------------

# Auth token for remote Turso databases. Leave empty for local files and
# `turso dev`; create one with `turso db tokens create <database>`.
TURSO_AUTH_TOKEN=

# Embedded replica: when set, TURSO_DATABASE_URL must be remote. The app reads
# from this local file and writes to the remote primary.
# TURSO_REPLICA_PATH=./storage/replica.db

# Background replica sync interval in seconds (0 = initial sync only).
# TURSO_SYNC_INTERVAL=60

# HTTP port the server listens on.
SERVER_PORT=3000

# JWT token lifetime in hours.
JWT_EXPIRATION_HOURS=24

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=*

# Directory where uploaded CVs are stored.
UPLOAD_DIR=./storage/uploads/cvs

# Set to "production" to disable the development admin seeder.
APP_ENV=development

# Redis connection settings (reserved for cache/queue).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Explicit path to the .env file that anchors relative paths.
# ENV_FILE=./.env
